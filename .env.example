# Copy to .env and edit as needed. .env is gitignored.
#
# There is no API key in this file, and there never will be. Switchboard runs
# entirely against a local Ollama instance. A non-localhost provider URL is
# rejected at startup - see switchboard/config.py.

SWITCHBOARD_OLLAMA_BASE_URL=http://localhost:11434

# Model used when a client sends "auto" or omits the model field.
# Milestone 1 serves every request from this one model.
SWITCHBOARD_DEFAULT_MODEL=qwen2.5:3b

SWITCHBOARD_HOST=127.0.0.1
SWITCHBOARD_PORT=8000

# Where the ledger lives. Run `switchboard db upgrade` after changing this.
SWITCHBOARD_DATABASE_URL=sqlite:///data/switchboard.db

# Record the full text of every request in the database.
#
# OFF by default, and think before turning it on: it means storing whatever
# your users type, which in most organisations includes customer data and
# credentials. Useful for training the routing classifier on real examples.
# Turn it on deliberately, tell your users, and protect the database file.
SWITCHBOARD_STORE_PROMPTS=false

# A cold 7b load on a 4GB GPU spills into system RAM; keep this generous.
SWITCHBOARD_READ_TIMEOUT=600
